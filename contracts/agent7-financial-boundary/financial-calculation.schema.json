{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed explicit financial calculation DTO; not endpoint admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gross_pnl",
    "net_pnl",
    "fees",
    "slippage",
    "funding",
    "currency",
    "unit",
    "profile_sha256",
    "calculation_basis",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "agent7.financial-calculation.v2"
    },
    "gross_pnl": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])"
    },
    "net_pnl": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])"
    },
    "fees": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])"
    },
    "slippage": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])"
    },
    "funding": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])"
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*(?![\\s\\S])"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*(?![\\s\\S])"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "calculation_basis": {
      "enum": [
        "GROSS_MINUS_SIGNED_COSTS",
        "NET_INCLUDES_SIGNED_COSTS"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_head",
        "source_tree",
        "input_manifest_sha256",
        "strategy_id",
        "strategy_version",
        "fidelity",
        "mode"
      ],
      "properties": {
        "source_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "input_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "strategy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*(?![\\s\\S])"
        },
        "strategy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*(?![\\s\\S])"
        },
        "fidelity": {
          "enum": [
            "PAPER_FIXTURE",
            "PAPER_SIMULATION"
          ]
        },
        "mode": {
          "enum": [
            "HISTORICAL",
            "LIVE_PAPER"
          ]
        }
      }
    }
  },
  "$comment": "Runtime conversion additionally binds exact fractional scale and currency/unit to caller-admitted profile digest; regex alone is not financial admission.",
  "$id": "urn:agent7:financial-calculation:v2"
}
