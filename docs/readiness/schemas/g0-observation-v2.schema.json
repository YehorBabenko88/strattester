    "nullableSha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "nullableGitSha": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "requiredValue": {
      "allOf": [
        {
          "not": {
            "type": "null"
          }
        },
        {
          "if": {
            "type": "string"
          },
          "then": {
            "pattern": "\\S"
          }
        }
      ]
    }
  },
