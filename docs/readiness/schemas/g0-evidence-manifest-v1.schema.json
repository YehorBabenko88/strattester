{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G0 diagnostic evidence manifest schema 1 / observation contract 2",
  "description": "Diagnostic format only. Validation never establishes physical truth, permission, G0/G1 acceptance or PASS.",
  "$defs": {
    "nullableSha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "nullableGitSha": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "fact": {
      "type": "object",
      "required": [
        "capture_state",
        "observed",
        "owner_receipt_sha256"
      ],
      "properties": {
        "capture_state": {
          "enum": [
            "OBSERVED",
            "EMPTY",
            "MISSING",
            "UNAVAILABLE",
            "NOT_COLLECTED"
          ]
        },
        "observed": {},
        "owner_receipt_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capture_state": {
                "enum": [
                  "NOT_COLLECTED",
                  "UNAVAILABLE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capture_state": {
                "const": "EMPTY"
              }
            }
          },
          "then": {
            "properties": {
              "observed": {
                "const": []
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capture_state": {
                "enum": [
                  "OBSERVED",
                  "MISSING"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed": {
                "anyOf": [
                  {
                    "type": "object",
                    "minProperties": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capture_state": {
                "const": "NOT_COLLECTED"
              }
            }
          },
          "then": {
            "patternProperties": {
              "_sha256$": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "purpose": {
      "const": "TARGET_SPECIFIC_G0_EVIDENCE_MANIFEST"
    },
    "manifest_state": {
      "const": "PLAN_ONLY_NOT_COLLECTED"
    },
    "execution_authorized": {
      "const": false
    },
    "release_binding": {
      "type": "object",
      "properties": {
        "source_sha": {
          "$ref": "#/$defs/nullableGitSha"
        },
        "tree_sha": {
          "$ref": "#/$defs/nullableGitSha"
        },
        "package_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "command_manifest_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "required": [
        "source_sha",
        "tree_sha",
        "package_sha256",
        "command_manifest_sha256"
      ],
      "additionalProperties": false
    },
    "collector_contract": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "observation_contract_version": {
          "type": "integer",
          "const": 2
        },
        "artifact_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "capture_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "capture_state": {
          "enum": [
            "OBSERVED",
            "EMPTY",
            "MISSING",
            "UNAVAILABLE",
            "NOT_COLLECTED"
          ]
        }
      },
      "required": [
        "schema",
        "observation_contract_version",
        "artifact_sha256",
        "capture_sha256",
        "capture_state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capture_state": {
                "const": "NOT_COLLECTED"
              }
            }
          },
          "then": {
            "properties": {
              "capture_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "not": {
                "pattern": "^(?:[Ll][Ss]5|[Pp][Cc]4)(?:\\.|$)"
              }
            }
          ]
        },
        "expected_host_identity_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "observed_host_identity_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "independent_identity_receipt_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "binding_status": {
          "const": "UNRESOLVED"
        },
        "protected_nodes": {
          "const": [
            "LS5",
            "PC4"
          ]
        }
      },
      "required": [
        "label",
        "expected_host_identity_sha256",
        "observed_host_identity_sha256",
        "independent_identity_receipt_sha256",
        "binding_status",
        "protected_nodes"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "object",
      "properties": {
        "host_identity": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {}
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "os_and_powershell": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {}
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "python_base_and_venv": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {},
            "executable_roster_sha256": {
              "$ref": "#/$defs/nullableSha256"
            }
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256",
            "executable_roster_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "torch_and_dependencies": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {},
            "wheel_lock_sha256": {
              "$ref": "#/$defs/nullableSha256"
            },
            "installed_metadata_sha256": {
              "$ref": "#/$defs/nullableSha256"
            }
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256",
            "wheel_lock_sha256",
            "installed_metadata_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "cpu_ram_disk_and_limits": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {},
            "enforcement_receipt_sha256": {
              "$ref": "#/$defs/nullableSha256"
            }
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256",
            "enforcement_receipt_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "gpu_driver_and_cuda": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {},
            "real_gpu_execution_evidence_sha256": {
              "$ref": "#/$defs/nullableSha256"
            }
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256",
            "real_gpu_execution_evidence_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "processes_and_services": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {},
            "pid_creation_identity_bindings_sha256": {
              "$ref": "#/$defs/nullableSha256"
            }
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256",
            "pid_creation_identity_bindings_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "tcp_and_udp_ports": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {},
            "pid_to_process_bindings_sha256": {
              "$ref": "#/$defs/nullableSha256"
            }
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256",
            "pid_to_process_bindings_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "acl_namespace_and_mounts": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {},
            "ancestor_acl_roster_sha256": {
              "$ref": "#/$defs/nullableSha256"
            },
            "backing_volume_identity_sha256": {
              "$ref": "#/$defs/nullableSha256"
            }
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256",
            "ancestor_acl_roster_sha256",
            "backing_volume_identity_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        },
        "source_and_database_ownership": {
          "type": "object",
          "properties": {
            "capture_state": {},
            "observed": {},
            "owner_receipt_sha256": {},
            "grid_postgresql_metaanalyse_ownership_roster_sha256": {
              "$ref": "#/$defs/nullableSha256"
            },
            "producer_receipts_sha256": {
              "$ref": "#/$defs/nullableSha256"
            }
          },
          "required": [
            "capture_state",
            "observed",
            "owner_receipt_sha256",
            "grid_postgresql_metaanalyse_ownership_roster_sha256",
            "producer_receipts_sha256"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            }
          ]
        }
      },
      "required": [
        "host_identity",
        "os_and_powershell",
        "python_base_and_venv",
        "torch_and_dependencies",
        "cpu_ram_disk_and_limits",
        "gpu_driver_and_cuda",
        "processes_and_services",
        "tcp_and_udp_ports",
        "acl_namespace_and_mounts",
        "source_and_database_ownership"
      ],
      "additionalProperties": false
    },
    "command_captures": {
      "description": "Untrusted descriptive JSON only; not executed, followed or admitted by this schema."
    },
    "observation_states": {
      "type": "object",
      "properties": {
        "OBSERVED": {
          "type": "string",
          "minLength": 1
        },
        "EMPTY": {
          "type": "string",
          "minLength": 1
        },
        "MISSING": {
          "type": "string",
          "minLength": 1
        },
        "UNAVAILABLE": {
          "type": "string",
          "minLength": 1
        },
        "NOT_COLLECTED": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "OBSERVED",
        "EMPTY",
        "MISSING",
        "UNAVAILABLE",
        "NOT_COLLECTED"
      ],
      "additionalProperties": false
    },
    "required_private_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "physical_g0_readiness": {
      "const": "PLAN_READY_TARGET_EVIDENCE_BLOCKED"
    },
    "physical_g1": {
      "const": "NOT_AUTHORIZED"
    },
    "trading": {
      "const": "NO-GO"
    }
  },
  "required": [
    "version",
    "purpose",
    "manifest_state",
    "execution_authorized",
    "release_binding",
    "collector_contract",
    "target",
    "facts",
    "command_captures",
    "observation_states",
    "required_private_bindings",
    "stop_conditions",
    "physical_g0_readiness",
    "physical_g1",
    "trading"
  ],
  "additionalProperties": false
}
