{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "experiment",
    "payload",
    "decision_ms",
    "analysis_now_ms"
  ],
  "properties": {
    "schema": {
      "const": "stratt.gateway.synthetic.research.request.v1-review1"
    },
    "operation": {
      "const": "meta.ohlcv.untouched_levels.v1"
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*(?![\\s\\S])"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)(?![\\s\\S])"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "venue",
        "market_type",
        "symbol",
        "timeframe",
        "units",
        "start_ms",
        "end_ms",
        "source",
        "evidence_class",
        "rows",
        "as_of_ms",
        "dataset_id"
      ],
      "properties": {
        "schema": {
          "const": "meta.ohlcv.research.request.v1"
        },
        "venue": {
          "const": "bybit"
        },
        "market_type": {
          "const": "linear"
        },
        "symbol": {
          "enum": [
            "BTCUSDT",
            "ETHUSDT",
            "SOLUSDT",
            "XRPUSDT",
            "BNBUSDT",
            "DOGEUSDT",
            "ADAUSDT",
            "AVAXUSDT",
            "LINKUSDT",
            "DOTUSDT"
          ]
        },
        "timeframe": {
          "const": "1m"
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price",
            "volume"
          ],
          "properties": {
            "price": {
              "enum": [
                "USDT/BTC",
                "USDT/ETH",
                "USDT/SOL",
                "USDT/XRP",
                "USDT/BNB",
                "USDT/DOGE",
                "USDT/ADA",
                "USDT/AVAX",
                "USDT/LINK",
                "USDT/DOT"
              ]
            },
            "volume": {
              "enum": [
                "BTC",
                "ETH",
                "SOL",
                "XRP",
                "BNB",
                "DOGE",
                "ADA",
                "AVAX",
                "LINK",
                "DOT"
              ]
            }
          }
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity",
            "source_revision",
            "retrieval_id",
            "retrieved_at_ms",
            "raw_sha256"
          ],
          "properties": {
            "kind": {
              "const": "HISTORICAL_BACKFILL"
            },
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
            },
            "source_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
            },
            "retrieval_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
            },
            "retrieved_at_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "raw_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        },
        "evidence_class": {
          "const": "SYNTHETIC"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_start_ms",
              "event_end_ms",
              "open",
              "high",
              "low",
              "close",
              "volume"
            ],
            "properties": {
              "event_start_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "event_end_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "open": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000000000
              },
              "high": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000000000
              },
              "low": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000000000
              },
              "close": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000000000
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000000
              }
            }
          }
        },
        "as_of_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "decision_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "analysis_now_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stratt.gateway.synthetic.research.request.v1-review1",
  "$comment": "PROPOSAL COMPONENT BOUNDARY ONLY. Exact bytes, duplicate-key parser, semantic cross-field/digest/source checks and actual owner admission are separate. No chart/runtime/shared API ACK from schema validity."
}
